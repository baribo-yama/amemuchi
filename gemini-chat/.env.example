# このファイルを .env にコピーして値を設定してください(.env は Git に入れない)
#   cp .env.example .env

# Google AI Studio で発行したAPIキー https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 使うモデル。モデル名は更新が早いので、公式ドキュメントで最新を確認してください
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite

# LLMの切り替え: gemini(本番) / mock(APIキー不要の動作確認用)
LLM_PROVIDER=gemini

PORT=3000

# 会話として送る直近メッセージ数の上限(古いものから切り捨て)
MAX_HISTORY_MESSAGES=20
# 1メッセージあたりの最大文字数
MAX_MESSAGE_CHARS=4000

# ログの保存先(プロジェクトルートからの相対パス)
LOG_DIR=logs
